# Copy to .env. Generate fresh secrets using scripts/secrets.py before starting.
JWT_SECRET=replace-with-at-least-32-random-characters
WORKER_SECRET=replace-with-another-32-random-characters
DEMO_PASSWORD=secureagent-demo
POSTGRES_PASSWORD=local-admin-demo
APP_DB_PASSWORD=local-app-demo
MODEL_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Conservative configurable reservation prices, not a claim about current pricing.
MODEL_INPUT_USD_PER_MILLION=10
MODEL_OUTPUT_USD_PER_MILLION=40
MAX_TOOL_CALLS=25
MAX_TOKENS=20000
MAX_COST_USD=0.50
RUN_TIMEOUT_SECONDS=300
RATE_LIMIT_PER_MINUTE=120
